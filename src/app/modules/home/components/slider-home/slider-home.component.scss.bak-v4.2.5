.home-slideshow .slide .slideshow-wrap,
.home-slideshow .slide picture,
.home-slideshow .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* LUJANDEV PREMIUM HERO START */

/* Conservar el posicionamiento original del slider */
:host .home-slideshow .slide .slideshow-content {
  .wrap-caption {

    .ss-small-title {
      color: #ffffff !important;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .ss-mega-title {
      color: #ffffff !important;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.025em;
      text-transform: uppercase;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
    }

    .ss-sub-title {
      color: #f0f0f0 !important;
      font-weight: 400;
      line-height: 1.5;
      max-width: 560px;
    }

    .ss-btnWrap {
      a {
        text-decoration: none;
      }

      .btn-dark-ld {
        background: #ffffff !important;
        color: #111111 !important;
        border: 1px solid #ffffff;
        border-radius: 0;
        font-weight: 600 !important;
        letter-spacing: 0.03em;
        cursor: pointer;

        &:hover {
          background: #111111 !important;
          color: #ffffff !important;
          border-color: #111111;
        }
      }
    }
  }
}

/* LUJANDEV PREMIUM HERO END */

/* LUJANDEV MOBILE HERO START */

@media (max-width: 767px) {

  :host .home-slideshow .slide {

    .slideshow-wrap {
      position: relative;
    }

    /* Degradado inferior para mejorar el contraste */
    .slideshow-wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(
        to bottom,
        transparent 25%,
        rgba(0, 0, 0, 0.12) 45%,
        rgba(0, 0, 0, 0.55) 100%
      );
    }

    .slideshow-content {
      z-index: 2;
    }

    .slideshow-content .wrap-caption {

      .ss-small-title {
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        margin-bottom: 0.75rem;
      }

      .ss-mega-title {
        font-size: clamp(1.75rem, 7vw, 2.5rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
      }

      .ss-sub-title {
        font-size: 0.85rem;
        line-height: 1.45;
        margin-bottom: 1.25rem;
      }

      .ss-btnWrap {
        margin-top: 1rem;

        .btn-dark-ld {
          padding: 0.85rem 1.25rem;
          font-size: 0.75rem;
          font-weight: 600 !important;
          letter-spacing: 0.04em;
        }
      }
    }
  }
}

/* LUJANDEV MOBILE HERO END */

/* LUJANDEV — HERO EDITORIAL V4.1.1 START */
/* Ajustes tipográficos móviles validados en DevTools. */
@media (max-width: 767px) {
  :host .home-slideshow .wrap-caption {
    .ss-small-title {
      font-size: 11px !important;
      font-weight: 500 !important;
      letter-spacing: 0.12em !important;
      margin-bottom: 10px !important;
    }

    .ss-mega-title {
      font-size: clamp(28px, 7vw, 36px) !important;
      line-height: 1.02 !important;
      letter-spacing: -0.035em !important;
      margin-bottom: 12px !important;
    }

    .ss-sub-title {
      font-size: 13px !important;
      line-height: 1.5 !important;
      max-width: 310px !important;
      margin-bottom: 16px !important;
    }

    .ss-btnWrap {
      margin-top: 12px !important;

      .btn-dark-ld {
        padding: 12px 18px !important;
        font-size: 11px !important;
        letter-spacing: 0.08em !important;
        border-radius: 0 !important;
      }
    }
  }
}
/* LUJANDEV — HERO EDITORIAL V4.1.1 END */
