.drop-editorial-header {
  text-align: left;
}

.drop-editorial-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.drop-editorial-top h2 {
  margin-bottom: 0;
}

.drop-editorial-controls {
  flex-shrink: 0;
}

.drop-editorial-controls .drop-toolbar {
  margin: 0;
  padding: 0 !important;
  background: transparent;
}

.drop-editorial-controls .drop-toolbar .row {
  margin: 0;
}

.drop-editorial-controls .filters-toolbar-item {
  padding: 0;
}

@media (max-width: 767px) {
  .drop-editorial-top {
    gap: 12px;
  }

  .drop-editorial-controls .grid-options {
    gap: 2px;
  }
}
