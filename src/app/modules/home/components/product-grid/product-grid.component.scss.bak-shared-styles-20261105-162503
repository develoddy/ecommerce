/* LUJANDEV — PREMIUM GRID CONTROLS START */

/* Aplicación limitada a DROP 001 */
.drop-editorial-controls .grid-options {
  display: flex;
  align-items: center;
  gap: 2px;
}

.drop-editorial-controls .grid-options .icon-mode {
  position: relative;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  min-width: 44px;
  padding: 0;
  margin: 0;
  background: transparent !important;
  border: 0;
  border-radius: 2px;
  cursor: pointer;
  opacity: 0.5;
  transition: opacity 180ms ease, background-color 180ms ease;
}

.drop-editorial-controls .grid-options .icon-mode::before,
.drop-editorial-controls .grid-options .icon-mode::after {
  content: none !important;
}

/* Geometría editorial mediante CSS */
.drop-editorial-controls .grid-options .icon-mode {
  --grid-icon-color: #222;
  --grid-icon-width: 20px;
  --grid-icon-height: 20px;
}

.drop-editorial-controls .grid-options .icon-mode .premium-grid-icon {
  display: block;
  width: var(--grid-icon-width);
  height: var(--grid-icon-height);
}

.drop-editorial-controls .grid-options .icon-mode.active {
  opacity: 1;
  background: #f3f3f3 !important;
}

.drop-editorial-controls .grid-options .icon-mode:hover {
  opacity: 1;
}

.drop-editorial-controls .grid-options .icon-mode:focus-visible {
  outline: 2px solid #111;
  outline-offset: 2px;
}

/* En móvil se muestran únicamente lista y 2 columnas */
@media (max-width: 767px) {
  .drop-editorial-controls .grid-options .grid-3,
  .drop-editorial-controls .grid-options .grid-4,
  .drop-editorial-controls .grid-options .grid-5 {
    display: none !important;
  }
}

/* LUJANDEV — PREMIUM GRID CONTROLS END */


